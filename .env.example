# Copiar a .env y completar con credenciales reales — NUNCA commitear .env.
# Ver AGIP_BASE_URL en playwright.config.js para overridear el ambiente de UI.

# Cluster MongoDB de QA_HOMO (Tracers.TracerInstance) — acceso de lectura/escritura
# directo a la base que respalda api-cct/api-publicador. Usado por lib/mongoAdmin.js
# para operaciones que la API no expone de forma puntual (ej. backdatear fechas de
# cuota para fabricar escenarios de Caducidad — ver memoria pfp-roadmap-fases del
# proyecto). Pedirle la connection string real al dueño del repo.
MONGO_URI=mongodb://usuario:password@host1:27017,host2:27017,host3:27017/admin?replicaSet=rs0&authSource=admin&authMechanism=SCRAM-SHA-1
MONGO_DB=Tracers
